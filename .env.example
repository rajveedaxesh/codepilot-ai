# Application Settings
APP_NAME="CodePilot AI"
APP_ENV=development
DEBUG=true

# AI Provider ("mock" or "anthropic")
LLM_PROVIDER=mock
# Provide key when LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Limits
MAX_UPLOAD_SIZE_BYTES=52428800
EXECUTION_TIMEOUT_SECONDS=30
ENABLE_ISOLATED_VERIFICATION=true
